---
import ThemeToggle from './ThemeToggle.astro';

const nav = [
  { href: '/dsa', label: 'DSA' },
  { href: '/daily-log', label: 'Daily Log' },
  { href: '/search', label: 'Search' },
];

const current = Astro.url.pathname;
---

<header class="sticky top-0 z-40 border-b border-hairline bg-canvas/90 backdrop-blur">
  <div class="mx-auto flex h-16 max-w-5xl items-center justify-between px-4 sm:px-6 lg:px-8">
    <a href="/" class="flex items-center gap-2 text-[15px] font-semibold tracking-tight text-ink">
      <span class="grid size-7 place-items-center rounded-md bg-brand-teal-deep text-brand-green">
        <span class="font-mono text-xs">{'</>'}</span>
      </span>
      dailydevlog
    </a>
    <nav class="flex items-center gap-1 overflow-x-auto">
      {
        nav.map((item) => {
          const active = current === item.href || current.startsWith(item.href + '/');
          return (
            <a
              href={item.href}
              class:list={[
                'shrink-0 rounded-full px-3 py-1.5 text-sm font-medium transition-colors',
                active ? 'bg-ink text-on-dark' : 'text-steel hover:text-ink',
              ]}
            >
              {item.label}
            </a>
          );
        })
      }
    </nav>
    <div class="flex items-center gap-2">
      <a
        href="https://github.com"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="View source on GitHub"
        class="grid size-9 place-items-center rounded-full border border-hairline-strong text-steel transition-colors hover:border-brand-green-dark hover:text-brand-green-dark dark:hover:text-brand-green"
      >
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-4">
          <path
            d="M12 .5C5.73.5.5 5.73.5 12c0 5.08 3.29 9.39 7.86 10.91.57.1.79-.25.79-.55 0-.27-.01-1.17-.02-2.12-3.2.7-3.88-1.36-3.88-1.36-.52-1.34-1.28-1.7-1.28-1.7-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.71 1.26 3.37.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.68 0-1.26.45-2.28 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.18 1.18a11 11 0 0 1 5.8 0c2.2-1.49 3.17-1.18 3.17-1.18.64 1.59.24 2.76.12 3.05.74.81 1.18 1.83 1.18 3.09 0 4.41-2.69 5.38-5.25 5.67.41.36.78 1.06.78 2.14 0 1.55-.01 2.79-.01 3.17 0 .3.21.66.8.55A10.52 10.52 0 0 0 23.5 12c0-6.27-5.23-11.5-11.5-11.5Z"
          ></path>
        </svg>
      </a>
      <ThemeToggle />
    </div>
  </div>
</header>

---
import { getStreak } from '../lib/activity';

const { day, goal } = await getStreak();
const pct = Math.min(100, Math.round((day / goal) * 100));
---

<div class="rounded-lg border border-hairline bg-canvas p-5">
  <div class="flex items-baseline justify-between">
    <p class="text-sm font-medium text-steel">Consistency streak</p>
    <p class="font-mono text-sm text-brand-green-dark dark:text-brand-green">{pct}%</p>
  </div>
  <p class="mt-1 text-2xl font-semibold text-ink">
    Day {day} <span class="text-base font-normal text-stone">of {goal}</span>
  </p>
  <div class="mt-3 h-2 w-full overflow-hidden rounded-full bg-surface-soft">
    <div class="h-full rounded-full bg-brand-green" style={`width: ${pct}%`}></div>
  </div>
</div>

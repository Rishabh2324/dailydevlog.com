---
interface Props {
  tags: string[];
  kinds?: { value: string; label: string }[];
  placeholder?: string;
}

const { tags, kinds, placeholder = 'Search by title or summary…' } = Astro.props;
---

<div class="flex flex-col gap-4" data-filter-root>
  <input
    type="search"
    data-filter-query
    placeholder={placeholder}
    class="h-11 w-full rounded-md border border-hairline-strong bg-canvas px-4 text-sm text-ink placeholder:text-steel focus:border-brand-green-dark focus:ring-1 focus:ring-brand-green-dark focus:outline-none"
  />
  {
    kinds && kinds.length > 0 && (
      <div class="flex flex-wrap gap-1.5">
        <button
          type="button"
          data-filter-kind="all"
          aria-pressed="true"
          class="rounded-full bg-ink px-3 py-1.5 text-sm font-medium text-on-dark"
        >
          All
        </button>
        {kinds.map((k) => (
          <button
            type="button"
            data-filter-kind={k.value}
            aria-pressed="false"
            class="rounded-full border border-hairline px-3 py-1.5 text-sm font-medium text-steel"
          >
            {k.label}
          </button>
        ))}
      </div>
    )
  }
  {
    tags.length > 0 && (
      <div class="flex flex-wrap gap-1.5">
        {tags.map((tag) => (
          <button
            type="button"
            data-filter-tag={tag.toLowerCase()}
            aria-pressed="false"
            class="rounded-full border border-hairline px-3 py-1.5 text-xs font-medium text-steel transition-colors"
          >
            {tag}
          </button>
        ))}
      </div>
    )
  }
  <p data-filter-empty hidden class="text-sm text-stone">No entries match your filters.</p>
</div>

<script>
  function initFilterBar(root: HTMLElement) {
    const query = root.querySelector<HTMLInputElement>('[data-filter-query]');
    const tagButtons = root.querySelectorAll<HTMLButtonElement>('[data-filter-tag]');
    const kindButtons = root.querySelectorAll<HTMLButtonElement>('[data-filter-kind]');
    const emptyState = root.querySelector<HTMLElement>('[data-filter-empty]');
    const items = document.querySelectorAll<HTMLElement>('[data-search-item]');

    const activeTags = new Set<string>();
    let activeKind = 'all';

    function setPressed(btn: HTMLButtonElement, pressed: boolean) {
      btn.setAttribute('aria-pressed', String(pressed));
      btn.classList.toggle('bg-ink', pressed);
      btn.classList.toggle('text-on-dark', pressed);
      btn.classList.toggle('border-hairline', !pressed);
      btn.classList.toggle('text-steel', !pressed);
    }

    function apply() {
      const q = (query?.value ?? '').trim().toLowerCase();
      let visibleCount = 0;
      items.forEach((item) => {
        const title = item.dataset.title ?? '';
        const summary = item.dataset.summary ?? '';
        const tagsAttr = item.dataset.tags ?? '';
        const kind = item.dataset.kind ?? '';

        const matchesQuery = !q || title.includes(q) || summary.includes(q);
        const matchesTags = activeTags.size === 0 || [...activeTags].some((t) => tagsAttr.includes(t));
        const matchesKind = activeKind === 'all' || kind === activeKind;

        const visible = matchesQuery && matchesTags && matchesKind;
        item.hidden = !visible;
        if (visible) visibleCount++;
      });
      if (emptyState) emptyState.hidden = visibleCount !== 0;
    }

    query?.addEventListener('input', apply);

    tagButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const tag = btn.dataset.filterTag!;
        const pressed = btn.getAttribute('aria-pressed') === 'true';
        if (pressed) activeTags.delete(tag);
        else activeTags.add(tag);
        setPressed(btn, !pressed);
        apply();
      });
    });

    kindButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        activeKind = btn.dataset.filterKind!;
        kindButtons.forEach((b) => setPressed(b, b === btn));
        apply();
      });
    });
  }

  document.querySelectorAll<HTMLElement>('[data-filter-root]').forEach(initFilterBar);
</script>

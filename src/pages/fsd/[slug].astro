---
import { getCollection, render } from 'astro:content';
import PostLayout from '../../layouts/PostLayout.astro';
import Badge from '../../components/Badge.astro';
import { tagVariant } from '../../lib/format';

export async function getStaticPaths() {
  const entries = await getCollection('fsd', ({ data }) => !data.draft);
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const { title, tags, stack, date, summary } = entry.data;
---

<PostLayout title={title} description={summary} date={date} backHref="/fsd" backLabel="All full stack posts">
  <Fragment slot="meta">
    {tags.map((t) => <Badge variant={tagVariant(t)}>{t}</Badge>)}
    {stack.map((s) => <Badge variant="neutral">{s}</Badge>)}
  </Fragment>

  <Content />
</PostLayout>

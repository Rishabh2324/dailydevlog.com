---
import { render } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Badge from '../../../components/Badge.astro';
import TopicList from '../../../components/course/TopicList.astro';
import { formatDate } from '../../../lib/format';
import { COURSE_IDS, getAllTopics, getCourse, levelInfo, moduleSlug } from '../../../lib/courses';

export async function getStaticPaths() {
  async function lessonPaths(course: (typeof COURSE_IDS)[number]) {
    const seasons = await getCourse(course);
    const topics = await getAllTopics(course);
    const published = topics.filter((t) => t.lesson);

    return seasons.flatMap((season) =>
      season.modules.flatMap((mod) =>
        mod.topics
          .filter((topic) => topic.lesson)
          .map((topic) => {
            const index = published.indexOf(topic);
            return {
              params: { course, module: moduleSlug(mod.id), lesson: topic.slug },
              props: {
                course,
                season,
                mod,
                topic,
                prerequisites: topic.lesson!.data.prerequisites.map((id) => topics.find((t) => t.id === id)!),
                prev: published[index - 1],
                next: published[index + 1],
              },
            };
          })
      )
    );
  }

  const paths = await Promise.all(COURSE_IDS.map(lessonPaths));
  return paths.flat();
}

const { course, season, mod, topic, prerequisites, prev, next } = Astro.props;
const lesson = topic.lesson!;
const level = levelInfo(course, topic.level);
const { Content } = await render(lesson);
const { summary, date, lastVerified, estimatedMinutes, references } = lesson.data;

const tiers = [
  { key: 'must', label: 'Must read' },
  { key: 'should', label: 'Should read' },
  { key: 'optional', label: 'Optional deep dive' },
] as const;
---

<BaseLayout title={`${topic.id} ${topic.title}`} description={summary}>
  <div class="grid gap-10 lg:grid-cols-[minmax(0,1fr)_15rem]">
    <article class="min-w-0">
      <a href={mod.href} class="text-sm font-medium text-brand-green-dark hover:underline dark:text-brand-green">
        &larr; Module {mod.id}: {mod.title}
      </a>

      <header class="mt-4 border-b border-hairline pb-6">
        <p class="text-xs font-semibold tracking-wide text-stone uppercase">
          Season {season.number} · Lesson {topic.id}
        </p>
        <h1 class="mt-2 text-3xl font-semibold tracking-tight text-ink sm:text-4xl">{topic.title}</h1>
        <p class="mt-3 text-slate">{summary}</p>
        <div class="mt-4 flex flex-wrap items-center gap-2">
          <Badge variant={level.variant}>{topic.level} · {level.label}</Badge>
          {topic.maturity && <Badge variant="orange">{topic.maturity}</Badge>}
          <span class="text-sm text-stone">
            {estimatedMinutes} min · <time datetime={date.toISOString()}>{formatDate(date)}</time>
          </span>
        </div>

        {
          topic.volatile && (
            <p class="mt-4 rounded-md border border-accent-orange/40 bg-accent-orange/5 px-4 py-2.5 text-sm text-charcoal">
              <strong>Fast-moving topic.</strong> APIs, versions and recommendations here change often.
              {lastVerified ? ` Last verified ${formatDate(lastVerified)}.` : ' Check the linked official docs.'}
            </p>
          )
        }

        {
          prerequisites.length > 0 && (
            <div class="mt-4 rounded-md border border-hairline bg-surface-soft px-4 py-3 text-sm">
              <p class="font-semibold text-ink">Prerequisites</p>
              <ul class="mt-1 flex flex-wrap gap-x-4 gap-y-1">
                {prerequisites.map((p) => (
                  <li>
                    <span class="font-mono text-xs text-stone">{p.id}</span>{' '}
                    {p.lesson ? (
                      <a href={p.href} class="text-brand-green-dark hover:underline dark:text-brand-green">
                        {p.title}
                      </a>
                    ) : (
                      <span class="text-slate">{p.title}</span>
                    )}
                  </li>
                ))}
              </ul>
            </div>
          )
        }
      </header>

      <div
        class="prose prose-neutral mt-8 max-w-none prose-headings:font-semibold prose-headings:tracking-tight prose-a:text-brand-green-dark dark:prose-invert dark:prose-a:text-brand-green"
      >
        <Content />
      </div>

      {
        references.length > 0 && (
          <section class="mt-12 border-t border-hairline pt-8" aria-labelledby="references">
            <h2 id="references" class="text-2xl font-semibold tracking-tight text-ink">
              Sources
            </h2>
            {tiers.map(({ key, label }) => {
              const items = references.filter((r) => r.tier === key);
              return (
                items.length > 0 && (
                  <div class="mt-6">
                    <h3 class="text-sm font-semibold tracking-wide text-stone uppercase">{label}</h3>
                    <ul class="mt-3 space-y-4">
                      {items.map((ref) => (
                        <li>
                          <a
                            href={ref.url}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="font-medium text-brand-green-dark hover:underline dark:text-brand-green"
                          >
                            {ref.title}
                          </a>
                          <span class="text-sm text-stone"> · {ref.source} · {ref.level}</span>
                          <p class="mt-0.5 text-sm text-slate">{ref.why}</p>
                        </li>
                      ))}
                    </ul>
                  </div>
                )
              );
            })}
          </section>
        )
      }

      <nav class="mt-12 grid gap-4 border-t border-hairline pt-6 sm:grid-cols-2" aria-label="Lesson navigation">
        {
          prev ? (
            <a href={prev.href} class="rounded-lg border border-hairline p-4 hover:border-hairline-strong">
              <span class="text-xs text-stone">&larr; Previous</span>
              <span class="mt-1 block font-medium text-ink">
                {prev.id} {prev.title}
              </span>
            </a>
          ) : (
            <span />
          )
        }
        {
          next && (
            <a href={next.href} class="rounded-lg border border-hairline p-4 text-right hover:border-hairline-strong">
              <span class="text-xs text-stone">Next &rarr;</span>
              <span class="mt-1 block font-medium text-ink">
                {next.id} {next.title}
              </span>
            </a>
          )
        }
      </nav>
    </article>

    <aside class="hidden lg:block">
      <div class="sticky top-24">
        <p class="text-xs font-semibold tracking-wide text-stone uppercase">Module {mod.id}</p>
        <p class="mt-1 text-sm font-semibold text-ink">{mod.title}</p>
        <div class="mt-3 max-h-[calc(100vh-10rem)] overflow-y-auto pr-1">
          <TopicList course={course} topics={mod.topics} currentId={topic.id} compact />
        </div>
      </div>
    </aside>
  </div>
</BaseLayout>

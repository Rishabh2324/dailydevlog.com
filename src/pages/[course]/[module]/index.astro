---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import TopicList from '../../../components/course/TopicList.astro';
import { COURSE_IDS, COURSES, courseHref, getCourse, moduleSlug } from '../../../lib/courses';

export async function getStaticPaths() {
  const paths = await Promise.all(
    COURSE_IDS.map(async (course) =>
      (await getCourse(course)).flatMap((season) =>
        season.modules.map((mod) => ({ params: { course, module: moduleSlug(mod.id) }, props: { course, season, mod } }))
      )
    )
  );
  return paths.flat();
}

const { course, season, mod } = Astro.props;
const published = mod.topics.filter((t) => t.lesson).length;
---

<BaseLayout title={`Module ${mod.id}: ${mod.title}`} description={mod.summary}>
  <a href={courseHref(course)} class="text-sm font-medium text-brand-green-dark hover:underline dark:text-brand-green">
    &larr; {COURSES[course].name} course
  </a>
  <header class="mt-4 border-b border-hairline pb-6">
    <p class="text-xs font-semibold tracking-wide text-stone uppercase">
      Season {season.number} · {season.title}
    </p>
    <h1 class="mt-2 text-3xl font-semibold tracking-tight text-ink sm:text-4xl">
      <span class="text-stone">{mod.id}</span>
      {mod.title}
    </h1>
    <p class="mt-3 max-w-2xl text-slate">{mod.summary}</p>
    <p class="mt-3 text-sm text-stone">
      {published} of {mod.topics.length} lessons published
      {mod.frontend && <span> · part of the AI for Frontend Engineers track</span>}
    </p>
  </header>

  <section class="mt-8">
    <h2 class="text-xl font-semibold tracking-tight text-ink">Lessons</h2>
    <div class="mt-3">
      <TopicList course={course} topics={mod.topics} />
    </div>
  </section>
</BaseLayout>

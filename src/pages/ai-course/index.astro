---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Badge from '../../components/Badge.astro';
import TopicList from '../../components/ai-course/TopicList.astro';
import Roadmap from '../../content/ai-course/roadmap.mdx';
import { getCourse, LEVELS, type Level } from '../../lib/ai-course';

const seasons = await getCourse();
const allTopics = seasons.flatMap((s) => s.modules.flatMap((m) => m.topics));
const published = allTopics.filter((t) => t.lesson).length;
const firstLesson = allTopics.find((t) => t.lesson);
---

<BaseLayout
  title="AI Engineering Course"
  description="A self-paced, written AI engineering curriculum for software engineers — from how LLMs work to production RAG, agents and MCP."
>
  <section class="rounded-lg border border-transparent bg-brand-teal-deep p-6 text-on-dark sm:p-10 dark:border-hairline-strong">
    <p class="text-xs font-semibold tracking-wide text-brand-green uppercase">Self-paced · written · build-first</p>
    <h1 class="mt-2 max-w-3xl text-3xl font-semibold tracking-tight sm:text-4xl">
      AI Engineering, from first principles to production
    </h1>
    <p class="mt-4 max-w-2xl leading-relaxed text-on-dark-muted">
      A written course for software engineers who want to build real AI products: how LLMs work, prompting and APIs,
      embeddings, RAG, tools, agents, MCP, evaluation, security and production architecture. Concepts first,
      frameworks second, TypeScript throughout.
    </p>
    <p class="mt-4 font-mono text-sm text-brand-green">
      Understand → Visualize → Explain → Build → Break → Debug → Apply
    </p>
    <div class="mt-6 flex flex-wrap items-center gap-3">
      {
        firstLesson && (
          <a href={firstLesson.href} class="rounded-full bg-brand-green px-5 py-2.5 text-sm font-semibold text-on-primary">
            Start with lesson {firstLesson.id}
          </a>
        )
      }
      <a href="#roadmap" class="rounded-full border border-on-dark-muted/50 px-5 py-2.5 text-sm font-semibold">
        See the roadmap
      </a>
      <span class="text-sm text-on-dark-muted">
        {published} of {allTopics.length} lessons published · {seasons.length} seasons
      </span>
    </div>
  </section>

  <section class="mt-12" aria-labelledby="levels">
    <h2 id="levels" class="text-xl font-semibold tracking-tight text-ink">Learning levels</h2>
    <p class="mt-1 text-sm text-slate">Every lesson is tagged with the level you should reach.</p>
    <ul class="mt-4 grid gap-3 sm:grid-cols-5">
      {
        (Object.keys(LEVELS) as Level[]).map((level) => (
          <li class="rounded-lg border border-hairline p-4">
            <Badge variant={LEVELS[level].variant}>{level}</Badge>
            <p class="mt-2 font-semibold text-ink">{LEVELS[level].label}</p>
            <p class="text-sm text-slate">{LEVELS[level].description}</p>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="mt-12" aria-labelledby="curriculum">
    <h2 id="curriculum" class="text-xl font-semibold tracking-tight text-ink">Curriculum</h2>
    <div class="mt-4 space-y-6">
      {
        seasons.map((season) => (
          <div class="rounded-lg border border-hairline p-5 sm:p-6">
            <p class="text-xs font-semibold tracking-wide text-brand-green-dark uppercase dark:text-brand-green">
              Season {season.number}
            </p>
            <h3 class="mt-1 text-xl font-semibold tracking-tight text-ink">{season.title}</h3>
            <p class="mt-1 text-sm text-slate">{season.summary}</p>
            <div class="mt-4 space-y-2">
              {season.modules.map((mod) => {
                const done = mod.topics.filter((t) => t.lesson).length;
                return (
                  <details class="group rounded-md border border-hairline-soft bg-surface px-4 py-3">
                    <summary class="flex cursor-pointer list-none items-baseline gap-3 [&::-webkit-details-marker]:hidden">
                      <span class="w-8 shrink-0 font-mono text-xs text-stone">{mod.id}</span>
                      <span class="flex-1 font-medium text-ink">
                        {mod.title}
                        {mod.frontend && <span class="ml-2 text-xs text-accent-blue">Frontend track</span>}
                      </span>
                      <span class="shrink-0 text-xs text-stone">
                        {done}/{mod.topics.length}
                      </span>
                      <span class="shrink-0 text-stone transition-transform group-open:rotate-90" aria-hidden="true">
                        ›
                      </span>
                    </summary>
                    <p class="mt-2 text-sm text-slate">
                      {mod.summary}{' '}
                      <a href={mod.href} class="text-brand-green-dark hover:underline dark:text-brand-green">
                        Module page &rarr;
                      </a>
                    </p>
                    <div class="mt-2">
                      <TopicList topics={mod.topics} />
                    </div>
                  </details>
                );
              })}
            </div>
          </div>
        ))
      }
    </div>
  </section>

  <section
    id="roadmap"
    class="prose prose-neutral mt-12 max-w-none scroll-mt-24 prose-headings:font-semibold prose-headings:tracking-tight prose-a:text-brand-green-dark dark:prose-invert dark:prose-a:text-brand-green"
  >
    <Roadmap />
  </section>
</BaseLayout>

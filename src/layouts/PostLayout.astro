---
import BaseLayout from './BaseLayout.astro';
import { formatDate } from '../lib/format';

interface Props {
  title: string;
  description: string;
  date: Date;
  backHref: string;
  backLabel: string;
}

const { title, description, date, backHref, backLabel } = Astro.props;
---

<BaseLayout title={title} description={description}>
  <article>
    <a href={backHref} class="text-sm font-medium text-brand-green-dark hover:underline dark:text-brand-green">
      &larr; {backLabel}
    </a>
    <header class="mt-4 border-b border-hairline pb-6">
      <time datetime={date.toISOString()} class="text-sm text-stone">{formatDate(date)}</time>
      <h1 class="mt-2 text-3xl font-semibold tracking-tight text-ink sm:text-4xl">{title}</h1>
      <div class="mt-4 flex flex-wrap items-center gap-2">
        <slot name="meta" />
      </div>
    </header>
    <div
      class="prose prose-neutral mt-8 max-w-none prose-headings:font-semibold prose-headings:tracking-tight prose-a:text-brand-green-dark dark:prose-invert dark:prose-a:text-brand-green"
    >
      <slot />
    </div>
  </article>
</BaseLayout>
